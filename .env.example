# Patchline backend configuration
# Copy this file to .env in the repository root (or backend/.env) and fill in real values.
# Never commit the real .env file. Placeholders below are empty or public defaults.

# openai_compatible calls POST {LLM_BASE_URL}/chat/completions.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=8192

# Optional. Required for private repositories and for a higher GitHub API rate limit.
# The token is read only on the backend. It is never sent to the browser or stored in reviews.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_HOST=github.com
GITHUB_TIMEOUT_SECONDS=30

# SQLite file. Relative paths are resolved from the backend directory.
DATABASE_PATH=data/reviews.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Input limits. MAX_REQUEST_BYTES must stay larger than MAX_DIFF_BYTES.
MAX_DIFF_BYTES=100000
MAX_DIFF_FILES=80
MAX_FINDINGS=30
MAX_REQUEST_BYTES=150000

LOG_LEVEL=INFO
APP_NAME=Patchline
HOST=127.0.0.1
PORT=8000
